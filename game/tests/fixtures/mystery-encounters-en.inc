    {"move", "{\"tackle\":{\"name\":\"Tackle\",\"effect\":\"A physical attack in which the user charges and slams into the target with its whole body.\"},\"surf\":{\"name\":\"Surf\",\"effect\":\"The user attacks everything around it by swamping its surroundings with a giant wave. This move’s power is doubled against targets submerged with Dive.\"},\"fly\":{\"name\":\"Fly\",\"effect\":\"The user flies up into the sky on the first turn, then attacks on the next turn.\"},\"thief\":{\"name\":\"Thief\",\"effect\":\"The user attacks and tries to steal from the target simultaneously. This move has a 30% chance to steal one of the target’s held items.\"},\"meanLook\":{\"name\":\"Mean Look\",\"effect\":\"The user pins the target with a dark, arresting look. The target becomes unable to flee or be switched out of battle.\"},\"charm\":{\"name\":\"Charm\",\"effect\":\"The user gazes at the target rather charmingly, making it less wary. This harshly lowers the target’s Attack stat.\"}}"},
    {"ability", "{\"intimidate\":{\"name\":\"Intimidate\",\"description\":\"When the Pokémon enters a battle, it intimidates opposing Pokémon and makes them cower, lowering their Attack stats.\"},\"shadowTag\":{\"name\":\"Shadow Tag\",\"description\":\"The Pokémon steps on the opposing Pokémon’s shadows to prevent them from fleeing or switching out.\"},\"static\":{\"name\":\"Static\",\"description\":\"The Pokémon is charged with static electricity and has a 30% chance to paralyze attackers that hit it with a contact move.\"}}"},
